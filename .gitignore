# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
test-results
*.local

# Generated per-run e2e auth fixture (real Supabase session tokens) — see e2e/global-setup.js.
# Never commit; regenerated fresh on every `npm run test:e2e`.
/e2e/.auth/

# Environment files — never commit real secrets. .env.example is the only tracked exception.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
