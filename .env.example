# Copy this file to .env.local (never .env) and fill in real values for local development.
# Never commit a real .env, .env.local, .env.staging or .env.production file — .gitignore
# already excludes all of them except this placeholder file.

# ---- Client-safe values (bundled into the frontend build — must never hold a secret) ----
# Any variable exposed to the browser MUST be prefixed VITE_. Never give a server-only
# secret (service role key, Stripe secret key, etc.) a VITE_ prefix — Vite inlines every
# VITE_-prefixed value into the shipped client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DEV-ONLY: skip the real Supabase email-OTP login screen for local UI inspection. Leave unset
# (or anything other than "true") to keep real auth as the default. Only takes effect when Vite
# itself is running in dev mode (`vite dev`/`vite build --mode development`) — a `vite build`
# production bundle hardcodes this check to false regardless of what this file contains, so it
# can never activate in a deployed build. It never grants backend privileges, never bypasses RLS,
# and never uses a service-role key — it only fakes local React state so the app shell renders;
# real Supabase reads/writes still run as a genuine, unauthenticated request. See
# src/config/devAuthBypass.js for the full explanation. Never commit this file set to "true".
# VITE_DEV_BYPASS_AUTH=true

# ---- Server-only values (Edge Functions / CI / migrations — never sent to the browser) ----
# Not used by this phase yet (no Edge Functions exist), placeholders only for when they do.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
