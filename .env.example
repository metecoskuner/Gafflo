# Copy this file to .env.local (never .env) and fill in real values for local development.
# Never commit a real .env, .env.local, .env.staging or .env.production file — .gitignore
# already excludes all of them except this placeholder file.

# ---- Client-safe values (bundled into the frontend build — must never hold a secret) ----
# Any variable exposed to the browser MUST be prefixed VITE_. Never give a server-only
# secret (service role key, Stripe secret key, etc.) a VITE_ prefix — Vite inlines every
# VITE_-prefixed value into the shipped client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server-only values (Edge Functions / CI / migrations — never sent to the browser) ----
# Not used by this phase yet (no Edge Functions exist), placeholders only for when they do.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
